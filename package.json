{
  "name": "aegisub-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:e2e": "pnpm build && playwright test --project=chromium --project=mobile-chromium",
    "test:e2e:firefox": "pnpm build && playwright test --project=firefox",
    "typecheck": "tsc -b",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt --write src tests",
    "fmt:check": "oxfmt --check src tests",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.20.0"
}
